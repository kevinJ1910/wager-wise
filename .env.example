# ─── Backend (secretos de Supabase Edge Functions) ───────────────
# Se cargan con:  supabase secrets set --env-file .env

SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Datos deportivos
# https://www.football-data.org/client/register  (tier gratuito: temporada en
# curso completa en 12 competiciones, entre ellas La Liga y Premier League;
# límite 10 req/min)
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_DAILY_LIMIT=500

# https://the-odds-api.com/  (tier gratuito: 500 créditos/mes)
# Coste por llamada = nº de mercados x nº de regiones
ODDS_API_KEY=
ODDS_API_MONTHLY_LIMIT=500

# ─── Gemini (Google AI Studio) ───────────────────────────────────
# Clave en https://aistudio.google.com/apikey
# El tier gratuito cubre los modelos Flash y Flash-Lite.
GEMINI_API_KEY=

# Confirma los IDs disponibles para tu clave con:
#   node scripts/list-gemini-models.mjs
# Google mantiene varios Flash estables a la vez y los renombra a menudo,
# por eso el ID va aquí y no escrito en el código.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LIGHT=gemini-3.5-flash-lite

# Interruptor de la capa de IA. En false la app sigue funcionando con los
# números del motor, sólo sin las explicaciones.
GEMINI_ENABLED=true
