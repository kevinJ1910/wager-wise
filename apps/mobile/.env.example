# Copia este fichero a .env dentro de apps/mobile.
# Sólo claves publicables: NUNCA la service role key en el cliente.

EXPO_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# El login con Google no necesita credenciales aquí: pasa por
# supabase.auth.signInWithOAuth, que delega el OAuth a Supabase. El Client
# ID/Secret de Google se configuran en el panel de Supabase (Authentication >
# Providers > Google), no en la app.

# Id del proyecto en EAS, lo imprime `eas init`. Sólo hace falta para builds
# nativos y para registrar el token de push; con Expo Go o web no se usa.
EAS_PROJECT_ID=
